---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    label: 'Feedstock',
    title: 'Built for the hardest waste',
    body: 'Polyolefins are half of all plastic and the least recyclable fraction. We accept mixed post-consumer streams that mechanical recycling cannot.',
  },
  {
    label: 'Process',
    title: 'Mild by design',
    body: 'No high-pressure reactors, no energy-intensive cracking, and a plant footprint that scales down as well as up.',
  },
  {
    label: 'Product',
    title: 'Diacids, not downcycling',
    body: 'Long-chain diacids that drop into polyester polyols and biodegradable polymers, sold on specification into existing supply chains.',
  },
];
---

<Layout>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="section-inner hero-inner">
      <span class="eyebrow">The Polymer Oxidation Company</span>
      <h1>Plastics and us,<br /><em>finally coexisting</em></h1>
      <p class="hero-sub">
        We're turning polyolefin waste into platform chemicals for biodegradable plastics.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Get in touch</a>
        <a href="#features" class="btn btn-ghost">Learn more</a>
      </div>
    </div>
  </section>

  <!-- ── BACKERS ──────────────────────────────────────────────── -->
  <section class="backers">
    <div class="section-inner backers-inner">
      <span class="backers-label">Supported by</span>
      <div class="backers-logos">
        <img src="/logos/deep-science-ventures.png" alt="Deep Science Ventures" class="backer-logo dsv" />
        <img src="/logos/valterra-platinum.webp" alt="Valterra Platinum" class="backer-logo" />
      </div>
    </div>
  </section>

  <!-- ── FEATURES ──────────────────────────────────────────────── -->
  <section class="features" id="features">
    <div class="section-inner">
      <span class="eyebrow">What we do</span>
      <h2>Oxidation that unlocks polyolefin waste</h2>
      <p class="section-sub">
        Our process runs at ambient pressure and low temperature (&lt;130 °C), converting waste polyolefins into dicarboxylic acids without energy-intensive infrastructure.
      </p>
      <div class="feature-grid">
        {features.map((f) => (
          <div class="card">
            <span class="card-label">{f.label}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────── -->
  <section class="cta-band on-dark" id="contact">
    <div class="section-inner cta-inner">
      <span class="eyebrow">Get started</span>
      <h2>Ready to learn more?</h2>
      <p>
        Replace this with a compelling reason to reach out or sign up.
      </p>
      <a href="mailto:sam.petcher@deepscienceventures.com" class="btn btn-light">Contact us</a>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    padding: var(--section-pad);
    padding-top: 7rem;
    border-bottom: var(--border-hairline);
  }

  .hero-inner {
    max-width: 54rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-h1);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 1.5rem;
  }

  h1 em {
    font-style: italic;
    color: var(--sage);
  }

  .hero-sub {
    font-size: var(--step-lead);
    color: var(--muted);
    max-width: 38rem;
    margin: 0 0 2.5rem;
    line-height: var(--leading-body);
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ── Backers ──────────────────────────────────────────────────── */
  .backers {
    padding: 2.5rem 1.5rem;
    border-bottom: var(--border-hairline);
  }

  .backers-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .backers-label {
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: var(--step-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  .backers-logos {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .backer-logo {
    height: 1.5rem;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.55;
    transition: opacity 0.15s ease;
  }

  .backer-logo.dsv {
    height: 1.75rem;
  }

  .backer-logo:hover {
    opacity: 0.9;
  }

  /* ── Features ─────────────────────────────────────────────────── */
  .features {
    padding: var(--section-pad);
    border-bottom: var(--border-hairline);
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-h2);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 1rem;
  }

  .section-sub {
    font-size: var(--step-lead);
    color: var(--muted);
    max-width: 48rem;
    margin: 0 0 3rem;
    line-height: var(--leading-body);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: var(--green-tint);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.75rem;
  }

  .card-label {
    display: inline-block;
    font-family: var(--font-accent);
    font-weight: 600;
    font-size: var(--step-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.75rem;
  }

  .card h3 {
    font-family: var(--font-sans);
    font-size: var(--step-card-title);
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .card p {
    font-size: var(--step-body);
    color: var(--muted);
    line-height: var(--leading-body);
    margin: 0;
    font-feature-settings: 'calt' 0;
  }

  /* ── CTA band ─────────────────────────────────────────────────── */
  .cta-band {
    background: var(--brand);
    padding: var(--section-pad);
  }

  .cta-inner {
    max-width: 42rem;
  }

  .cta-band h2 {
    color: var(--cream);
    margin-bottom: 1rem;
  }

  .cta-band p {
    font-size: var(--step-lead);
    color: var(--muted-on-dark);
    line-height: var(--leading-body);
    margin: 0 0 2rem;
  }
</style>
